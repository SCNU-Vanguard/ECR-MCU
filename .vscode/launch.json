{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "demo_h7(DAPLink/pyOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "pyocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/output/demo_h7/demo_h7.elf",
      "targetId": "stm32h723vgtx",
      "gdbPath": "arm-none-eabi-gdb",
      "overrideGDBServerStartedRegex": "GDB server (started|listening) (at|on) port",
      "preLaunchTask": "build demo_h7",
      "runToEntryPoint": "main"
    }
  ]
}

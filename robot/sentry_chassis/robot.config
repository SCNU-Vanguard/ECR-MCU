# 底盘板（板间 slave）。make r=sentry_chassis
# 配置名严格按文件路径命名：每一级目录一个开关，下一级名字 = 上一级名字 + 下一级目录/文件名。
# 注意：每行只写 "名字 = y/n"，行尾不要加注释。需要注释请单独写一行。

# ---- osal ----
CONFIG_OSAL                                         = y
    CONFIG_OSAL_TASK_STATS                          = y
    CONFIG_OSAL_CPU_USAGE                           = y

# ---- component ----
CONFIG_COMPONENT                                    = y
    CONFIG_COMPONENT_LOG                            = y
    CONFIG_COMPONENT_SHELL                          = y
    CONFIG_COMPONENT_PID                            = y
    CONFIG_COMPONENT_DSP                            = n
    CONFIG_COMPONENT_AHRS                           = y
        CONFIG_COMPONENT_AHRS_VQF                   = y
        CONFIG_COMPONENT_AHRS_MEKF                  = n
        CONFIG_COMPONENT_AHRS_MADGWICK              = n
        CONFIG_COMPONENT_AHRS_MAHONY                = n
    CONFIG_COMPONENT_FILTER                         = n
    CONFIG_COMPONENT_CRC                            = y
    CONFIG_COMPONENT_POWER                          = y
    CONFIG_COMPONENT_CHASSIS                        = y
        CONFIG_COMPONENT_CHASSIS_MECANUM            = n
        CONFIG_COMPONENT_CHASSIS_OMNI               = y
        CONFIG_COMPONENT_CHASSIS_SWERVE             = n

# ---- bsp ----
CONFIG_BSP                                          = y
    CONFIG_BSP_GPIO                                 = y
    CONFIG_BSP_UART                                 = y
    CONFIG_BSP_CAN                                  = y
    CONFIG_BSP_SPI                                  = y
    CONFIG_BSP_PWM                                  = y
    CONFIG_BSP_USB                                  = n

# ---- cdd ----
CONFIG_CDD                                          = y
    CONFIG_CDD_REMOTE                               = n
    CONFIG_CDD_MOTOR                                = y
        CONFIG_CDD_MOTOR_DJI_MOTOR                  = y
        CONFIG_CDD_MOTOR_DM_MOTOR                   = y
        CONFIG_CDD_MOTOR_LK_MOTOR                   = n
    CONFIG_CDD_IMU                                  = y
        CONFIG_CDD_IMU_BMI088                       = y
        CONFIG_CDD_IMU_INS                          = y
        CONFIG_CDD_IMU_HEATER                       = y
    CONFIG_CDD_LED                                  = y
        CONFIG_CDD_LED_WS2812                       = y
    CONFIG_CDD_BUZZER                               = y
    CONFIG_CDD_SERVO                                = y
    CONFIG_CDD_VOFA                                 = y
    CONFIG_CDD_SUPERCAP                             = y
    CONFIG_CDD_REFEREE                              = y
        CONFIG_CDD_REFEREE_UI                       = y
    CONFIG_CDD_IMGTRANS                             = n
    CONFIG_CDD_HOST                                 = n
    CONFIG_CDD_INTERBOARD                           = y
        CONFIG_CDD_INTERBOARD_MASTER                = n
        CONFIG_CDD_INTERBOARD_SLAVE                 = y

# ---- appl ----
CONFIG_APPL                                         = y
    CONFIG_APPL_SENTRY_CHASSIS                        = y
        CONFIG_APPL_SENTRY_CHASSIS_LED_CTRL           = y
        CONFIG_APPL_SENTRY_CHASSIS_BUZZER_CTRL        = y
        CONFIG_APPL_SENTRY_CHASSIS_HEATER_CTRL        = y
        CONFIG_APPL_SENTRY_CHASSIS_CHASSIS_CTRL       = y
        CONFIG_APPL_SENTRY_CHASSIS_YAW_CTRL           = y
        CONFIG_APPL_SENTRY_CHASSIS_SHOOT_CTRL         = y
        CONFIG_APPL_SENTRY_CHASSIS_UI_CTRL            = y

# ---- robot ----
CONFIG_ROBOT                                        = y
    CONFIG_ROBOT_SENTRY_CHASSIS                       = y

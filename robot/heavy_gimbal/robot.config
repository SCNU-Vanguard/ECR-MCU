# 云台板（板间 master）。make r=heavy_gimbal
# 配置名严格按文件路径命名：每一级目录一个开关，下一级名字 = 上一级名字 + 下一级目录/文件名。
# 注意：每行只写 "名字 = y/n"，行尾不要加注释。需要注释请单独写一行。

# ---- osal：任务统计（执行时间、激活频率、唤醒延迟、栈余量……），手动触发 task_stats_dump() ----
CONFIG_OSAL                                         = y
    CONFIG_OSAL_TASK_STATS                          = y
    # CPU 占用统计（空闲钩子里累计空闲时间），shell 命令 cpu
    CONFIG_OSAL_CPU_USAGE                           = y

# ---- component：日志、命令行、PID ----
CONFIG_COMPONENT                                    = y
    CONFIG_COMPONENT_LOG                            = y
    CONFIG_COMPONENT_SHELL                          = y
    CONFIG_COMPONENT_PID                            = y
    CONFIG_COMPONENT_DSP                            = n
    CONFIG_COMPONENT_AHRS                           = y
        CONFIG_COMPONENT_AHRS_VQF                   = y
        CONFIG_COMPONENT_AHRS_MEKF                  = n
        CONFIG_COMPONENT_AHRS_MADGWICK              = n
        CONFIG_COMPONENT_AHRS_MAHONY                = n
    CONFIG_COMPONENT_FILTER                         = n
    CONFIG_COMPONENT_CRC                            = y
    CONFIG_COMPONENT_POWER                          = n
    CONFIG_COMPONENT_CHASSIS                        = n

# ---- bsp：外设抽象 ----
CONFIG_BSP                                          = y
    CONFIG_BSP_GPIO                                 = y
    CONFIG_BSP_UART                                 = y
    CONFIG_BSP_CAN                                  = y
    CONFIG_BSP_SPI                                  = y
    CONFIG_BSP_PWM                                  = y
    CONFIG_BSP_USB                                  = y

# ---- cdd：设备驱动 ----
CONFIG_CDD                                          = y
    CONFIG_CDD_REMOTE                               = y
        CONFIG_CDD_REMOTE_DT7                       = y
    CONFIG_CDD_MOTOR                                = y
        CONFIG_CDD_MOTOR_DJI_MOTOR                  = y
        CONFIG_CDD_MOTOR_DM_MOTOR                   = n
        CONFIG_CDD_MOTOR_LK_MOTOR                   = n
    CONFIG_CDD_IMU                                  = y
        CONFIG_CDD_IMU_BMI088                       = y
        CONFIG_CDD_IMU_INS                          = y
        CONFIG_CDD_IMU_HEATER                       = y
    CONFIG_CDD_LED                                  = y
        CONFIG_CDD_LED_WS2812                       = y
    CONFIG_CDD_BUZZER                               = y
    CONFIG_CDD_SERVO                                = y
    CONFIG_CDD_VOFA                                 = y
    CONFIG_CDD_SUPERCAP                             = n
    CONFIG_CDD_REFEREE                              = n
    CONFIG_CDD_IMGTRANS                             = y
    CONFIG_CDD_HOST                                 = y
        CONFIG_CDD_HOST_AIM                         = y
        CONFIG_CDD_HOST_NAV                         = y
    CONFIG_CDD_INTERBOARD                           = y
        CONFIG_CDD_INTERBOARD_MASTER                = y
        CONFIG_CDD_INTERBOARD_SLAVE                 = n

# ---- appl：应用 ----
CONFIG_APPL                                         = y
    CONFIG_APPL_HEAVY_GIMBAL                         = y
        CONFIG_APPL_HEAVY_GIMBAL_LED_CTRL            = y
        CONFIG_APPL_HEAVY_GIMBAL_BUZZER_CTRL         = y
        CONFIG_APPL_HEAVY_GIMBAL_HEATER_CTRL         = y
        CONFIG_APPL_HEAVY_GIMBAL_GIMBAL_CTRL         = y
        CONFIG_APPL_HEAVY_GIMBAL_SHOOT_CTRL          = y
        CONFIG_APPL_HEAVY_GIMBAL_HOST_CTRL           = y
        CONFIG_APPL_HEAVY_GIMBAL_INTERBOARD_CTRL     = y

# ---- robot：机器人 ----
CONFIG_ROBOT                                        = y
    CONFIG_ROBOT_HEAVY_GIMBAL                        = y

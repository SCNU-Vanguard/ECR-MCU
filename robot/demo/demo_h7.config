# demo 兵种 / STM32H723 的编译配置（make p=h7 r=demo 读取本文件）
# 格式与 dsar-mcu 的 product/*.config 相同：CONFIG_XXX = y | n。缩进只表示从属关系，方便阅读；
# 子项依赖父项、模块依赖外设，这些约束由 build/config.mk 检查，写错会在编译前报错。
# 注意：每行只写 "名字 = y/n"，行尾不要加注释。需要注释请单独写一行。

# ---- 任务统计（执行时间、激活频率、唤醒延迟、栈余量……），手动触发 task_stats_dump() ----
CONFIG_TASK_STATS                           = y

# ---- 日志与命令行 ----
# log 模块：日志，由 EasyLogger 实现（component/log）。其它模块都用 LOGx，建议保持 y
CONFIG_LOG                                  = y
CONFIG_SHELL                                = n

# ---- 机器人 ----
CONFIG_ROBOT_DEMO                           = y
CONFIG_ROBOT_BIND_CHASSIS                   = n

# ---- 外设抽象 bsp ----
CONFIG_BSP                                  = y
    CONFIG_BSP_GPIO                         = y
    CONFIG_BSP_UART                         = y
    CONFIG_BSP_CAN                          = y
    CONFIG_BSP_SPI                          = y
    CONFIG_BSP_PWM                          = y
    CONFIG_BSP_USB                          = y

# ---- 设备驱动 cdd ----
CONFIG_CDD                                  = y
    CONFIG_CDD_REMOTE_DT7                   = y
    CONFIG_CDD_MOTOR_DJI                    = y
    CONFIG_CDD_IMU_BMI088                   = y
    CONFIG_CDD_LED_WS2812                   = y
    CONFIG_CDD_BUZZER                       = y

# ---- 应用 ----
CONFIG_APPL                                 = y
    CONFIG_APPL_DEMO                        = y


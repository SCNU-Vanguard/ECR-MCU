# demo 兵种 / STM32H723 的编译配置（make p=h7 r=demo 读取本文件）
# 配置名严格按文件路径命名（兵种目录 robot/demo 除外）：每一级目录一个开关，下一级名字 = 上一级名字 + 下一级目录/文件名。
# 子项依赖父项、模块依赖外设，这些约束由 build/config.mk 检查，写错会在编译前报错。
# 注意：每行只写 "名字 = y/n"，行尾不要加注释。需要注释请单独写一行。

# ---- osal：任务统计（执行时间、激活频率、唤醒延迟、栈余量……），手动触发 task_stats_dump() ----
CONFIG_OSAL                                         = y
    CONFIG_OSAL_TASK_STATS                          = y
    # CPU 占用统计（空闲钩子里累计空闲时间），shell 命令 cpu
    CONFIG_OSAL_CPU_USAGE                           = y

# ---- component：日志、命令行、PID ----
# 日志建议保持 y
CONFIG_COMPONENT                                    = y
    CONFIG_COMPONENT_LOG                            = y
    CONFIG_COMPONENT_SHELL                          = y
    CONFIG_COMPONENT_PID                            = y
    # CMSIS-DSP 预编译库（滤波算法用）
    CONFIG_COMPONENT_DSP                            = y
    CONFIG_COMPONENT_MATHLIB                        = y
    # 姿态滤波算法：一个开关一个算法，ahrs 是统一调用接口（默认算法在 robot_cfg.h，运行时可用 ins_algo 切换）
    CONFIG_COMPONENT_FILTER                         = y
        CONFIG_COMPONENT_FILTER_AHRS                = y
        CONFIG_COMPONENT_FILTER_VQF                 = y
        CONFIG_COMPONENT_FILTER_MEKF                = y
        CONFIG_COMPONENT_FILTER_MADGWICK            = y
        CONFIG_COMPONENT_FILTER_MAHONY              = y
        CONFIG_COMPONENT_FILTER_EKF                 = y
        CONFIG_COMPONENT_FILTER_KALMAN              = y
        CONFIG_COMPONENT_FILTER_LPF                 = n
        CONFIG_COMPONENT_FILTER_NORMAL              = n
# ---- bsp：外设抽象 ----
CONFIG_BSP                                          = y
    CONFIG_BSP_GPIO                                 = y
    CONFIG_BSP_UART                                 = y
    CONFIG_BSP_CAN                                  = y
    CONFIG_BSP_SPI                                  = y
    CONFIG_BSP_PWM                                  = y
    CONFIG_BSP_USB                                  = y

# ---- cdd：设备驱动 ----
CONFIG_CDD                                          = y
    CONFIG_CDD_REMOTE                               = y
        CONFIG_CDD_REMOTE_DT7                       = y
    CONFIG_CDD_MOTOR                                = y
        CONFIG_CDD_MOTOR_DJI_MOTOR                  = y
        CONFIG_CDD_MOTOR_DM_MOTOR                   = y
    CONFIG_CDD_IMU                                  = y
        CONFIG_CDD_IMU_BMI088                       = y
        CONFIG_CDD_IMU_HEATER                       = y
    CONFIG_CDD_LED                                  = y
        CONFIG_CDD_LED_WS2812                       = y
    CONFIG_CDD_BUZZER                               = y

# ---- appl：应用 ----
CONFIG_APPL                                         = y
    CONFIG_APPL_DEMO                                = y
        CONFIG_APPL_DEMO_LED_CTRL                   = y
        CONFIG_APPL_DEMO_BUZZER_CTRL                = y
        CONFIG_APPL_DEMO_CHASSIS_CTRL               = y
        CONFIG_APPL_DEMO_GIMBAL_CTRL                = y
        CONFIG_APPL_DEMO_SHOOT_CTRL                 = y
        CONFIG_APPL_DEMO_INS_TASK                   = y
        CONFIG_APPL_DEMO_HEATER_CTRL                = y

# ---- robot：机器人 ----
CONFIG_ROBOT                                        = y
    CONFIG_ROBOT_DEMO                               = y
        CONFIG_ROBOT_DEMO_ROBOT_INIT                = y

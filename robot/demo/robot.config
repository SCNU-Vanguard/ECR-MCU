# 本兵种的编译配置（make r=<兵种> 读取 robot/<兵种>/robot.config，与平台无关）
# 配置名严格按文件路径命名（兵种目录 robot/demo 除外）：每一级目录一个开关，下一级名字 = 上一级名字 + 下一级目录/文件名。
# 注意：每行只写 "名字 = y/n"，行尾不要加注释。需要注释请单独写一行。

# ---- osal：任务统计（执行时间、激活频率、唤醒延迟、栈余量……），手动触发 task_stats_dump() ----
CONFIG_OSAL                                         = y
    CONFIG_OSAL_TASK_STATS                          = y
    # CPU 占用统计（空闲钩子里累计空闲时间），shell 命令 cpu
    CONFIG_OSAL_CPU_USAGE                           = y

# ---- component：日志、命令行、PID ----
# 日志建议保持 y
CONFIG_COMPONENT                                    = y
    CONFIG_COMPONENT_LOG                            = y
    CONFIG_COMPONENT_SHELL                          = y
    CONFIG_COMPONENT_PID                            = y
    # CMSIS-DSP 预编译库。MEKF 打开时一起打开
    CONFIG_COMPONENT_DSP                            = n
    # 姿态解算。一个开关一个算法，ahrs 只编译打开的算法；用哪个在 cdd/imu/ins/ins.c 的 INS_ALGORITHM
    CONFIG_COMPONENT_AHRS                           = y
        CONFIG_COMPONENT_AHRS_VQF                   = y
        CONFIG_COMPONENT_AHRS_MEKF                  = n
        CONFIG_COMPONENT_AHRS_MADGWICK              = n
        CONFIG_COMPONENT_AHRS_MAHONY                = n
    # 通用数据滤波
    CONFIG_COMPONENT_FILTER                         = y
        CONFIG_COMPONENT_FILTER_LPF                 = n
        CONFIG_COMPONENT_FILTER_MOVING_AVERAGE      = n
        CONFIG_COMPONENT_FILTER_MEDIAN              = n
    # 裁判系统帧和 VT03 图传帧的 CRC8 / CRC16
    CONFIG_COMPONENT_CRC                            = y
    # 底盘运动学。一个开关一种构型，兵种任务只调用自己用的那一种
    CONFIG_COMPONENT_CHASSIS                        = y
        CONFIG_COMPONENT_CHASSIS_MECANUM            = y
        CONFIG_COMPONENT_CHASSIS_OMNI               = n
        CONFIG_COMPONENT_CHASSIS_SWERVE             = n
        
# ---- bsp：外设抽象 ----
CONFIG_BSP                                          = y
    CONFIG_BSP_GPIO                                 = y
    CONFIG_BSP_UART                                 = y
    CONFIG_BSP_CAN                                  = y
    CONFIG_BSP_SPI                                  = y
    CONFIG_BSP_PWM                                  = y
    CONFIG_BSP_USB                                  = y

# ---- cdd：设备驱动 ----
CONFIG_CDD                                          = y
    CONFIG_CDD_REMOTE                               = y
        CONFIG_CDD_REMOTE_DT7                       = y
    CONFIG_CDD_MOTOR                                = y
        CONFIG_CDD_MOTOR_DJI_MOTOR                  = y
        CONFIG_CDD_MOTOR_DM_MOTOR                   = y
    CONFIG_CDD_IMU                                  = y
        CONFIG_CDD_IMU_BMI088                       = y
        CONFIG_CDD_IMU_INS                          = y
        CONFIG_CDD_IMU_HEATER                       = y
    CONFIG_CDD_LED                                  = y
        CONFIG_CDD_LED_WS2812                       = y
    CONFIG_CDD_BUZZER                               = y
    # 裁判系统：接收解析 + 发送。UI 是绘图原语，具体界面由应用层画
    CONFIG_CDD_REFEREE                              = y
        CONFIG_CDD_REFEREE_UI                       = y
    # VT03 图传链路遥控器（键鼠 + 摇杆）
    CONFIG_CDD_IMGTRANS                             = y
    # USB 上位机链路。自瞄和导航分开，两个都可以关
    CONFIG_CDD_HOST                                 = y
        CONFIG_CDD_HOST_AIM                         = y
        CONFIG_CDD_HOST_NAV                         = y
    # 板间 RS485（USART2 硬件 DE）。MASTER / SLAVE 只开一个
    CONFIG_CDD_INTERBOARD                           = y
        CONFIG_CDD_INTERBOARD_MASTER                = y
        CONFIG_CDD_INTERBOARD_SLAVE                 = n

# ---- appl：应用 ----
CONFIG_APPL                                         = y
    CONFIG_APPL_DEMO                                = y
        CONFIG_APPL_DEMO_LED_CTRL                   = y
        CONFIG_APPL_DEMO_BUZZER_CTRL                = y
        CONFIG_APPL_DEMO_CHASSIS_CTRL               = y
        CONFIG_APPL_DEMO_GIMBAL_CTRL                = y
        CONFIG_APPL_DEMO_SHOOT_CTRL                 = y
        CONFIG_APPL_DEMO_HEATER_CTRL                = y
        CONFIG_APPL_DEMO_HOST_CTRL                  = y
        CONFIG_APPL_DEMO_INTERBOARD_CTRL            = y

# ---- robot：机器人 ----
CONFIG_ROBOT                                        = y
    CONFIG_ROBOT_DEMO                               = y

